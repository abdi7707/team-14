# Copy to .env at the repository root. Never commit real values.

# API server
# Required. PostgreSQL connection string, e.g. postgres://user:password@host:5432/sened
DATABASE_URL=
# Required, at least 32 characters. The API refuses to boot without it.
SESSION_SECRET=
# Required. Google AI Studio key used for document generation.
GEMINI_API_KEY=
# Optional. Defaults to gemini-flash-latest.
GEMINI_MODEL=
# Optional. Set to v1beta only if Gemini rejects requests on the SDK's default v1 API.
GOOGLE_GENAI_API_VERSION=
# Optional, comma-separated. Accounts registered with these emails get the admin role.
ADMIN_EMAILS=
# Optional. Number of proxies in front of the API, used to find the client IP for rate limits.
# Defaults to 1. Use 3 on Render (Cloudflare and two Render proxies).
TRUST_PROXY_HOPS=
# Defaults: PORT=3000, NODE_ENV=development, LOG_LEVEL=info
PORT=
NODE_ENV=
LOG_LEVEL=

# Object storage (P2 — only if uploads are built)
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# Mobile app
EXPO_PUBLIC_DOMAIN=
