# Copy to .env at the repository root. Never commit real values.

# API server
# Required. PostgreSQL connection string, e.g. postgres://user:password@host:5432/sened
DATABASE_URL=
# Required, at least 32 characters. The API refuses to boot without it.
SESSION_SECRET=
GEMINI_API_KEY=
# Optional, comma-separated. Accounts registered with these emails get the admin role.
ADMIN_EMAILS=
# Defaults: PORT=3000, NODE_ENV=development, LOG_LEVEL=info
PORT=
NODE_ENV=
LOG_LEVEL=

# Object storage (P2 — only if uploads are built)
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

# Mobile app
EXPO_PUBLIC_DOMAIN=
